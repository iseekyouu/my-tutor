{
  "name": "my-tutor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot server/index.ts",
    "start": "NODE_ENV=production bun server/index.ts",
    "build": "bun build ./index.html --outdir dist --production --env 'PUBLIC_*'",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint",
    "deploy": "bun scripts/deploy.ts",
    "deploy:db": "bun scripts/deploy.ts --with-db"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.94.0",
    "typescript": "~7.0.2"
  }
}
